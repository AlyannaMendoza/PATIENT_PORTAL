@model PATIENT_PORTAL.Models.Patient

@{
    ViewBag.Title = "Patient Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .info-box {
        padding: 10px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 8px;
        font-size: 16px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header text-center py-3 rounded-top-4">
            <h1 class="mb-0">@Model.FirstName @Model.MiddleName @Model.LastName</h1>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <!-- Column 1 -->
                <div class="col-md-6">
                    <div class="info-box">
                        <strong>Blood Type:</strong> @Model.BloodType
                    </div>
                    <div class="info-box">
                        <strong>Age:</strong> @Model.Age
                    </div>
                    <div class="info-box">
                        <strong>Birth Date:</strong> @Model.BirthDate.ToString("MMMM dd, yyyy")
                    </div>
                    <div class="info-box">
                        <strong>Place of Birth:</strong> @Model.PlaceOfBirth
                    </div>
                    <div class="info-box">
                        <strong>Sex:</strong> @Model.Sex
                    </div>
                    <div class="info-box">
                        <strong>Civil Status:</strong> @Model.CivilStatus
                    </div>
                </div>

                <!-- Column 2 -->
                <div class="col-md-6">
                    <div class="info-box">
                        <strong>Nationality:</strong> @Model.Nationality
                    </div>
                    <div class="info-box">
                        <strong>Contact Number:</strong> @Model.ContactNumber
                    </div>
                    <div class="info-box">
                        <strong>Address:</strong> @Model.StreetAddress, @Model.City, @Model.Province, @Model.ZipCode
                    </div>
                    <div class="info-box">
                        <strong>Suffix:</strong> @Model.Suffix
                    </div>
                    <div class="info-box">
                        <strong>Status:</strong>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </div>
                    <div class="info-box">
                        <div class="btn-group">
                            <button type="button" class="btn btn-secondary btn-lg dropdown-toggle" data-bs-toggle="dropdown">
                                List of Cases
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a href="@Url.Action("Create", "PATIENT_CaseInfo")">
                                        <i class="fa fa-plus"></i> Add New
                                    </a>
                                </li>
                                @foreach (var item in Model.CaseInfos)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Details", "PATIENT_CaseInfo", new { id = item.Id })">@item.CaseNumber</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="card-footer bg-light text-end rounded-bottom-4">
            @Html.ActionLink("Edit Patient Details", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary me-3" })
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header text-center py-3 rounded-top-4">
            <h3 class="mb-0">Vital Signs</h3>
        </div>
        <table id="patientsTable" class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Date Checked</th>
                    <th>Blood Pressure</th>
                    <th>Temperature</th>
                    <th>Pulse Rate</th>
                    <th>RespiratoryRate</th>
                    <th>OxygenSaturation</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.VitalSigns)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.DateChecked)</td>
                        <td>@Html.DisplayFor(modelItem => item.BloodPressure)</td>
                        <td>@Html.DisplayFor(modelItem => item.Temperature)</td>
                        <td>@Html.DisplayFor(modelItem => item.PulseRate)</td>
                        <td>@Html.DisplayFor(modelItem => item.RespiratoryRate)</td>
                        <td>@Html.DisplayFor(modelItem => item.OxygenSaturation)</td>
                        <td><a href="@Url.Action("Edit", "PATIENT_VitalSigns", new { id = item.Id })" class="btn btn-info">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="card-footer bg-light text-end rounded-bottom-4">
            <a href="@Url.Action("Create", "PATIENT_VitalSigns")" class="btn btn-success">
                <i class="fa fa-plus"></i> Add New Vitals
            </a>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header text-center py-3 rounded-top-4">
            <h3 class="mb-0">Body Mass Index</h3>
        </div>
        <table id="patientsTable" class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Date Checked</th>
                    <th>Height</th>
                    <th>Weight</th>
                    <th>Body Mass</th>
                    <th>Category</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.BMIs)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.DateChecked)</td>
                        <td>@Html.DisplayFor(modelItem => item.Height)</td>
                        <td>@Html.DisplayFor(modelItem => item.Weight)</td>
                        <td>@Html.DisplayFor(modelItem => item.BodyMass)</td>
                        <td>@Html.DisplayFor(modelItem => item.Category)</td>
                        <td><a href="@Url.Action("Edit", "PATIENT_BMIs", new { id = item.Id })" class="btn btn-info">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="card-footer bg-light text-end rounded-bottom-4">
            <a href="@Url.Action("Create", "PATIENT_BMIs")" class="btn btn-success">
                <i class="fa fa-plus"></i> Add New BMI
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}