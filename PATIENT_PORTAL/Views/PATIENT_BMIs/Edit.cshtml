@model PATIENT_PORTAL.Models.BMI

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>


<div class="card border-dark mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3>Body Mass Index Form</h3>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card-body">
            <div class="row g-3">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.Id)

                <div class="col-md-4">
                    <label for="PatientId" class="form-label">Patient Name<span style="color: red;">*</span></label>
                    @Html.DropDownList("PatientId", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.PatientId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label for="DateChecked" class="form-label">Date Checked<span style="color: red;">*</span></label>
                    @Html.TextBoxFor(model => model.DateChecked, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.DateChecked, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label for="Height" class="form-label">Height<span style="color: red;">*</span></label>
                    @Html.EditorFor(model => model.Height, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Height, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label for="Weight" class="form-label">Weight<span style="color: red;">*</span></label>
                    @Html.EditorFor(model => model.Weight, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Weight, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label for="BodyMass" class="form-label">Body Mass</label>
                    @Html.DisplayFor(model => model.BodyMass, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.BodyMass, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label for="Category" class="form-label">Category</label>
                    @Html.DisplayFor(model => model.Category, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
                </div>

                <hr />
                <div class="col-12">
                    <button class="btn btn-success" type="submit" value="Create">Submit</button>
                </div>
            </div>
        </div>
    }

</div>

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
