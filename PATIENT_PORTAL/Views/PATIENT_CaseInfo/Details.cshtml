@model PATIENT_PORTAL.Models.CaseInfo

@{
    ViewBag.Title = "Case Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg rounded">
        <div class="card-header">
            <h2 class="mb-0">Case Information</h2>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>Patient Name</th>
                        <td>@Model.Patient.FirstName @Model.Patient.MiddleName @Model.Patient.LastName</td>
                    </tr>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.CaseNumber)</th>
                        <td>@Html.DisplayFor(model => model.CaseNumber)</td>
                    </tr>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.DateCreated)</th>
                        <td>@Html.DisplayFor(model => model.DateCreated)</td>
                    </tr>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.AttendingPhysician)</th>
                        <td>@Html.DisplayFor(model => model.AttendingPhysician)</td>
                    </tr>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.SignsSymptoms)</th>
                        <td>@Html.DisplayFor(model => model.SignsSymptoms)</td>
                    </tr>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Diagnosis)</th>
                        <td>@Html.DisplayFor(model => model.Diagnosis)</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer text-end">
            <a class="dropdown-item" href="@Url.Action("Details", "Patients", new { id = Model.Patient.Id })">Patient Details</a>
            @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning me-2" })
            @Html.ActionLink("Back to Case List", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>
