@model IEnumerable<PATIENT_PORTAL.Models.CaseInfo>

@{
    ViewBag.Title = "Case List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Case List</h2>
            <a href="@Url.Action("Create", "PATIENT_CaseInfo")" class="btn btn-success">
                <i class="fa fa-plus"></i> Add New
            </a>
        </div>

        <div class="card-body">
            <table id="caseinfoTable" class="table table-striped table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>Patient Name</th>
                        <th>@Html.DisplayNameFor(model => model.CaseNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.DateCreated)</th>
                        <th>@Html.DisplayNameFor(model => model.AttendingPhysician)</th>
                        <th>@Html.DisplayNameFor(model => model.Diagnosis)</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Patient.LastName, @item.Patient.FirstName</td>
                            <td> @Html.DisplayFor(modelItem => item.CaseNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.DateCreated)</td>
                            <td>@Html.DisplayFor(modelItem => item.AttendingPhysician)</td>
                            <td>@Html.DisplayFor(modelItem => item.Diagnosis)</td>
                            <td class="status">
                                @if (item.Patient.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Edit", "PATIENT_CaseInfo", new { id = item.Id })">Edit</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("Details", "PATIENT_CaseInfo", new { id = item.Id })">Details</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            var table = $('#caseinfoTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false
            });
        });
    </script>

    <!-- Include SweetAlert2 for Better Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
